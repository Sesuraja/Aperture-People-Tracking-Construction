rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@gaostaff\\.com'))
      );
    }

    match /alerts/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /devices/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /live_tags/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /floorplans/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /registered_people/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /tag_history/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /visitors/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.hostEmail == request.auth.token.email ||
        resource.data.hostId == request.auth.uid
      );
    }

    match /visitor_security_list/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /visitor_access_tokens/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /visitor_access_logs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /audit_logs/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /projects/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
