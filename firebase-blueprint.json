{
  "entities": {
    "Alert": {
      "title": "Alert",
      "description": "System security and info alerts",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number", "description": "Unix timestamp" }
      },
      "required": ["type", "message", "timestamp"]
    },
    "Device": {
      "title": "Device",
      "description": "RFID Readers and Devices",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "zone": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "LiveTag": {
      "title": "Live Tag",
      "description": "Real-time tracking tags",
      "type": "object",
      "properties": {
        "TagID": { "type": "string" },
        "Location": { "type": "string" },
        "Timestamp": { "type": "string" },
        "dwellTime": { "type": "number" },
        "lastSeen": { "type": "string" },
        "activityInsights": {
          "type": "object",
          "properties": {
            "activity": { "type": "string" },
            "confidence": { "type": "number" }
          }
        }
      },
      "required": ["TagID", "Location", "Timestamp"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Equipment assets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["id", "name", "type", "x", "y"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["id", "name", "type", "x", "y"]
    },
    "CameraDevice": {
      "title": "CameraDevice",
      "description": "Camera devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["id", "name", "x", "y"]
    },
    "EnvSensor": {
      "title": "EnvSensor",
      "description": "Environment sensors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["id", "name", "x", "y"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App settings",
      "type": "object",
      "properties": {
        "apiUrl": { "type": "string" },
        "demoMode": { "type": "boolean" }
      }
    },
    "DashboardLayout": {
      "title": "Dashboard Layout",
      "description": "User customized dashboard layout configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "kpis": {
          "type": "array",
          "description": "Array of KPI configurations"
        },
        "panels": {
          "type": "array",
          "description": "Array of panel configurations"
        },
        "updatedAt": { "type": "string" }
      }
    },
    "Visitor": {
      "title": "Visitor",
      "description": "Visitor pre-registration and tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "host": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "time": { "type": "string" },
        "tag": { "type": "string" },
        "location": { "type": "string" },
        "duration": { "type": "string" },
        "path": { "type": "array" },
        "qrCodeRef": { "type": "string" },
        "arrivalTime": { "type": "number" },
        "isOverstayed": { "type": "boolean" }
      },
      "required": ["id", "name", "company", "status"]
    }
  },
  "firestore": {
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Alerts triggered by GAO tags"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Configured reader devices"
    },
    "/live_tags/{tagId}": {
      "schema": "LiveTag",
      "description": "Currently active tags"
    },
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Equipment assets"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Vehicles"
    },
    "/cameras/{cameraId}": {
      "schema": "CameraDevice",
      "description": "Camera devices"
    },
    "/sensors/{sensorId}": {
      "schema": "EnvSensor",
      "description": "Environment sensors"
    },
    "/settings/dashboard_{userId}": {
      "schema": "DashboardLayout",
      "description": "User specific dashboard layout config"
    },
    "/settings/{document}": {
      "schema": "Setting",
      "description": "App settings"
    },
    "/visitors/{visitorId}": {
      "schema": "Visitor",
      "description": "Pre-registered and active visitors"
    }
  }
}
